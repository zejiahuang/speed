# 规则自动拉取 —— crontab 示例
#
# 安装：crontab -e 后把下面需要的一行粘进去（记得把路径改成实际路径）。
# 也可以用 /etc/cron.d/rules-puller（注意该目录下的文件需要属主 root 且不带扩展名）。

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# 如果 PHP 不在 PATH 里，直接指定绝对路径
PHP_BIN=/usr/bin/php

# 每天 04:17 拉取一次。
# 选 17 分而不是 0 分：整点是与全世界任务撞车最严重的时刻，偏移几分钟更容易成功。
17 4 * * * /bin/bash /opt/rules-puller/cron/pull.sh

# 想跑得更勤（比如每 6 小时）就用这行代替上面那行：
# 23 */6 * * * /bin/bash /opt/rules-puller/cron/pull.sh

# 每周日 05:00 强制全量重下（忽略 ETag / Last-Modified）：
# 0 5 * * 0 /bin/bash /opt/rules-puller/cron/pull.sh --force
