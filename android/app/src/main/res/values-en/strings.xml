<?xml version="1.0" encoding="utf-8"?>
<!--
  All user-visible text lives in these resources rather than in the Kotlin, so a
  second language is a `values-en/` directory and nothing else.

  `values/strings.xml` (Simplified Chinese) is the source of truth; the English
  file is generated from it by `tools/make-values-en.py`, which copies every
  element and comment verbatim, replaces only the text, and refuses to write if
  the two disagree about a name or a format specifier. Edit the Chinese file and
  re-run the script; do not edit the generated one.
-->
